<%- include('layout', { title: 'Browse Extensions' }) %>

<div class="container mt-4">
  <div class="row mb-4">
    <div class="col">
      <h2><i class="bi bi-grid-3x3-gap"></i> Browse Extensions</h2>
    </div>
  </div>

  <%
    const _blockedSet = new Set(typeof blockedExtIds !== 'undefined' ? blockedExtIds : []);
    const _showBlocked = typeof showBlocked !== 'undefined' && showBlocked;
  %>

  <form method="GET" action="/" class="row mb-4">
    <div class="col-md-8 col-lg-6">
      <div class="input-group">
        <input type="text" class="form-control" name="search" placeholder="Search extensions..." value="<%= search %>">
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
      </div>
    </div>
    <div class="col-md-4 col-lg-6 d-flex align-items-center mt-2 mt-md-0">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showBlocked" name="show_blocked" value="1" <%= _showBlocked ? 'checked' : '' %> onchange="this.form.submit()">
        <label class="form-check-label" for="showBlocked">Show blocked extensions</label>
      </div>
    </div>
  </form>

  <% if (extensions.length === 0) { %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-inbox" style="font-size: 3rem;"></i>
      <p class="mt-2"><%= search ? 'No extensions found for "' + search + '"' : 'Search for extensions to get started' %></p>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% extensions.forEach(function(ext) {
        const pub = ext.publisher?.publisherName || 'unknown';
        const name = ext.extensionName || 'unknown';
        const extId = (pub + '.' + name).toLowerCase();
        const isBlocked = _blockedSet.has(extId);
        const displayName = ext.displayName || name;
        const shortDesc = ext.shortDescription || '';
        const version = ext.versions?.[0];
        const iconFile = version?.files?.find(f => f.assetType === 'Microsoft.VisualStudio.Services.Icons.Default' || f.assetType === 'Microsoft.VisualStudio.Services.Icons.Small');
        const iconUrl = iconFile?.source || '';
        const stats = ext.statistics || [];
        const installs = stats.find(s => s.statisticName === 'install')?.value || 0;
        const rating = stats.find(s => s.statisticName === 'averagerating')?.value || 0;
      %>
      <div class="col-md-6 col-lg-4">
        <a href="/extension/<%= pub %>/<%= name %>" class="text-decoration-none">
          <div class="card ext-card<%= isBlocked ? ' border-danger' : '' %>" style="<%= isBlocked ? 'opacity: 0.6;' : '' %>">
            <div class="card-body d-flex">
              <% if (iconUrl) { %>
                <img src="<%= iconUrl %>" alt="" class="ext-icon me-3">
              <% } else { %>
                <div class="ext-icon me-3 bg-secondary d-flex align-items-center justify-content-center text-white rounded">
                  <i class="bi bi-puzzle"></i>
                </div>
              <% } %>
              <div class="overflow-hidden">
                <h6 class="card-title mb-1 text-dark text-truncate">
                  <%= displayName %>
                  <% if (isBlocked) { %>
                    <span class="badge bg-danger ms-1" style="font-size: 0.65em;">Blocked</span>
                  <% } %>
                </h6>
                <small class="text-muted"><%= pub %></small>
                <p class="card-text small text-muted mt-1 text-truncate"><%= shortDesc %></p>
                <div class="d-flex gap-3 small text-muted">
                  <span><i class="bi bi-download"></i> <%= Math.round(installs).toLocaleString() %></span>
                  <% if (rating > 0) { %>
                  <span><i class="bi bi-star-fill text-warning"></i> <%= rating.toFixed(1) %></span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/?search=<%= encodeURIComponent(search) %>&page=<%= page - 1 %><%= _showBlocked ? '&show_blocked=1' : '' %>">Previous</a>
        </li>
        <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="/?search=<%= encodeURIComponent(search) %>&page=<%= i %><%= _showBlocked ? '&show_blocked=1' : '' %>"><%= i %></a>
        </li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/?search=<%= encodeURIComponent(search) %>&page=<%= page + 1 %><%= _showBlocked ? '&show_blocked=1' : '' %>">Next</a>
        </li>
      </ul>
    </nav>
    <% } %>
  <% } %>
</div>

<%- include('footer') %>
